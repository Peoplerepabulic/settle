# --- Provider ---
# "imessage" (default) needs SPECTRUM_PROJECT_ID/SECRET from the Photon dashboard.
# "terminal" runs a local CLI chat with no credentials — great for demos/dev.
PROVIDER=imessage

# --- Photon Spectrum (only needed for PROVIDER=imessage) ---
# Get these from https://app.photon.codes (dashboard) after signing up.
# HackWashU promo code: HACKWITHPHOTON (free Pro month).
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# --- LLM (OpenAI-compatible chat API) ---
# Optional but strongly recommended. Without a key, Settle falls back to
# simple keyword heuristics so the terminal demo still works end-to-end.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Tuning ---
# How long the "any vetoes?" window stays open after a winner is announced.
VETO_WINDOW_MS=60000
# Inactivity timeout before Settle auto-tallies an in-progress vote.
TALLY_TIMEOUT_MS=600000
